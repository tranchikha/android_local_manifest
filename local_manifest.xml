<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="krpi" fetch="https://github.com/tranchikha" />
  <remote name="github" fetch="https://github.com" />

  <project path="device/broadcom/rpi4" name="android_device_broadcom_rpi4" remote="krpi" revision="android16" />
  <project path="device/broadcom/rpi-common" name="android_device_broadcom_rpi-common" remote="krpi" revision="android16" />
  <project path="vendor/broadcom/proprietary" name="android_vendor_broadcom_proprietary" remote="krpi" revision="android16" />

  <!--Android u-boot -->
  <project path="external/u-boot" name="android_external_u-boot" remote="krpi" revision="main" />

  <!--Custom scripts for generating Android image -->
  <project path="vendor/broadcom/boot_scripts" name="boot_scripts" remote="krpi" revision="main" >
    <linkfile src="gensdimg.sh" dest="gensdimg.sh" />
  </project>

  <!-- Graphics parts -->
  <remove-project path="external/minigbm" name="platform/external/minigbm" />
  <project path="external/minigbm" name="android_external_minigbm" remote="krpi" revision="android-17.0.0_r1" />
  <!-- 26.2.0-devel of https://gitlab.freedesktop.org/mesa/mesa -->
  <project path="external/mesa3d-rpi" name="android_external_mesa3d-rpi" remote="krpi" revision="main" />
  <!-- Tools for Generating Android.bp for mesa-rpi -->
  <remove-project name="platform/external/rust/ninja-to-soong" />
  <project path="external/rust/ninja-to-soong" name="android_external_rust_ninja-to-soong" remote="krpi" revision="android-16.0" />

  <!-- Display HAL -->
  <remove-project path="external/drm_hwcomposer" name="platform/external/drm_hwcomposer" />
  <!-- drm-hwcomposer upstream latest
    84f5b1692 Move refresh rate change logging -->
  <project path="external/drm_hwcomposer" name="android_external_drm_hwcomposer" remote="krpi" revision="main" />

  <remove-project path="hardware/interfaces" name="platform/hardware/interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="krpi" revision="android-17.0.0_r1" />

  <!-- HAL -->
  <project path="vendor/broadcom/hal/usbgadget" name="android_vendor_broadcom_hal_usbgadget" remote="krpi" revision="android14" />
  <project path="vendor/broadcom/hal/audio" name="android_vendor_broadcom_hal_audio" remote="krpi" revision="android14" />
  <project path="vendor/broadcom/hal/gps" name="android_vendor_broadcom_hal_gps" remote="krpi" revision="android14" />
  <project path="vendor/broadcom/hal/camera" name="android_vendor_broadcom_hal_camera" remote="krpi" revision="android16" />

  <!-- AOSP -->
  <remove-project path="build/soong" name="platform/build/soong"/>
  <project path="build/soong" name="android_build_soong" remote="krpi" revision="android-17.0.0_r1" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <remove-project path="frameworks/native" name="platform/frameworks/native" />
  <project path="frameworks/native" name="android_frameworks_native" remote="krpi" revision="android-17.0.0_r1" />
  <project path="vendor/partner_gms" name="lineageos4microg/android_vendor_partner_gms" remote="github" revision="master" />
  <!-- Unused repo -->
  <remove-project path="device/amlogic/yukawa" name="device/amlogic/yukawa" />
</manifest>
